# Server Configuration
PORT=5000
NODE_ENV=development
API_PREFIX=/api/v1

# CORS
CORS_ORIGIN=http://localhost:3000

# Logging
LOG_LEVEL=debug

# Database (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/talkchat_db?schema=public"

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT Secrets
JWT_ACCESS_SECRET=your_super_secret_access_jwt_key_here_at_least_32_chars
JWT_REFRESH_SECRET=your_super_secret_refresh_jwt_key_here_at_least_32_chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Cloudinary
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

