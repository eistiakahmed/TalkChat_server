model User {
  id              String    @id @default(uuid()) @db.Uuid
  username        String    @unique @db.VarChar(50)
  email           String    @unique @db.VarChar(255)
  passwordHash    String    @db.VarChar(255)
  fullName        String    @db.VarChar(100)
  avatarUrl       String?   @db.Text
  avatarPublicId  String?   @db.VarChar(255)
  bio             String?   @db.VarChar(255)
  isEmailVerified Boolean   @default(false)
  isOnline        Boolean   @default(false)
  lastSeen        DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relationships
  refreshTokens        RefreshToken[]
  deviceSessions       DeviceSession[]
  memberships          ConversationMember[]
  messagesSent         Message[]
  messageReceipts      MessageReceipt[]
  reactions            MessageReaction[]
  createdConversations Conversation[]       @relation("CreatedConversations")

  contactsInitiated Contact[] @relation("UserContacts")
  contactsReceived  Contact[] @relation("ContactUsers")

  blockedUsers   BlockedUser[] @relation("UserBlocker")
  blockedByUsers BlockedUser[] @relation("UserBlocked")

  @@index([username])
  @@index([email])
  @@index([isOnline])
  @@map("users")
}

model RefreshToken {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @db.Uuid
  token      String   @unique @db.VarChar(255)
  deviceInfo String?  @db.VarChar(255)
  ipAddress  String?  @db.VarChar(45)
  isRevoked  Boolean  @default(false)
  expiresAt  DateTime
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@map("refresh_tokens")
}

model DeviceSession {
  id         String     @id @default(uuid()) @db.Uuid
  userId     String     @db.Uuid
  fcmToken   String     @db.Text
  deviceType DeviceType @default(WEB)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, fcmToken])
  @@index([userId])
  @@map("device_sessions")
}
