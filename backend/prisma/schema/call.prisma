model CallLog {
  id             String     @id @default(uuid()) @db.Uuid
  callerId       String     @db.Uuid
  receiverId     String     @db.Uuid
  conversationId String?    @db.Uuid
  type           CallType   @default(AUDIO)
  status         CallStatus @default(INITIATED)
  startedAt      DateTime   @default(now())
  answeredAt     DateTime?
  endedAt        DateTime?
  duration       Int?       // Call duration in seconds
  endReason      String?    @db.VarChar(50)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  caller   User @relation("CallsMade", fields: [callerId], references: [id], onDelete: Cascade)
  receiver User @relation("CallsReceived", fields: [receiverId], references: [id], onDelete: Cascade)

  @@index([callerId])
  @@index([receiverId])
  @@index([status])
  @@index([createdAt(sort: Desc)])
  @@map("call_logs")
}
